<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane id="mainMenuPane" prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/global-styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zeki.myagend.controller.scene.ContactsSceneController">
   <top>
      <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#addContact" styleClass="model-ButtonA" text="Añadir contacto" />
            <HBox alignment="CENTER">
               <children>
                  <TextField fx:id="txtSearch" alignment="CENTER" promptText="Buscar contacto" />
               </children>
            </HBox>
            <ColorPicker />
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" top="20.0" />
         </BorderPane.margin>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" maxHeight="400.0" maxWidth="450.0" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="boxPaneContactList" alignment="TOP_CENTER" spacing="20.0" />
         </content>
         <padding>
            <Insets left="20.0" />
         </padding>
      </ScrollPane>
   </center>
</BorderPane>
